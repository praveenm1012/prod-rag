# Application
APP_NAME=prod-rag
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# RAG
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=.cache/embeddings
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_MIN_SECONDS=1.0
EMBEDDING_RETRY_MAX_SECONDS=10.0
EMBEDDING_NORMALIZE=true
EMBEDDING_SHOW_PROGRESS=true

# Integration tests (set to 1 to run embedding integration tests)
# RUN_EMBEDDING_INTEGRATION=0
# RUN_DOCKER_TESTS=0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=prod_rag
QDRANT_VECTOR_SIZE=1024
# QDRANT_API_KEY=

# Lexical search
LEXICAL_TOP_K=10
LEXICAL_BM25_K1=1.5
LEXICAL_BM25_B=0.75

# Hybrid retrieval
HYBRID_BM25_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_TOP_K=10
HYBRID_CANDIDATE_POOL_SIZE=50

# Reranking
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=32
RERANKER_TOP_K=5
RERANKER_MAX_RETRIES=3
RERANKER_RETRY_MIN_SECONDS=1.0
RERANKER_RETRY_MAX_SECONDS=10.0
RERANKER_SHOW_PROGRESS=true

# Prompt builder
PROMPT_MAX_CONTEXT_TOKENS=4096
PROMPT_RESERVED_RESPONSE_TOKENS=512
PROMPT_TOKEN_ENCODING=cl100k_base
# PROMPT_SYSTEM=
# PROMPT_CONTEXT_HEADER=Context:
# PROMPT_EXAMPLES_HEADER=Examples:
# PROMPT_HISTORY_HEADER=Previous conversation:
# PROMPT_QUESTION_PREFIX=Question:
# PROMPT_ANSWER_PREFIX=Answer:

# LLM_API_KEY=
