# Application
APP_NAME=prod-rag
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# RAG
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=.cache/embeddings
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_MIN_SECONDS=1.0
EMBEDDING_RETRY_MAX_SECONDS=10.0
EMBEDDING_NORMALIZE=true
EMBEDDING_SHOW_PROGRESS=true

# Integration tests (set to 1 to run embedding integration tests)
# RUN_EMBEDDING_INTEGRATION=0

# VECTOR_STORE_URL=
# LLM_API_KEY=
